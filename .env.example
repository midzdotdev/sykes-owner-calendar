# Copy to .env (gitignored) for local development. Nitro loads .env automatically.
# This file is the single source of truth for secrets — push it to each platform
# with that platform's CLI (see README), so you're never locked to one host.

# Server private key for credential tokens (P-256, PKCS8 PEM).
# Generate with: node scripts/generate-token-key.mjs
# Multi-line: quote the whole PEM, or store it single-line with \n escapes.
TOKEN_PRIVATE_KEY=

# Only needed to run the live e2e locally (npm run test:e2e:live):
SYKES_EMAIL=
SYKES_PASSWORD=
SYKES_PROPERTY_ID=
