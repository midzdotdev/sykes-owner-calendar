{
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "nitropack prepare",
    "dev": "nitropack dev",
    "build": "nitropack build",
    "preview": "node .output/server/index.mjs",
    "test": "vitest",
    "typecheck": "nitropack prepare && tsc --noEmit",
    "test:e2e": "npm run build && SMOKE_MODE=fixture node test/e2e/smoke.mjs",
    "test:e2e:live": "npm run build && SMOKE_MODE=live node test/e2e/smoke.mjs"
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "date-fns": "^4.4.0",
    "ical-generator": "^11.0.0",
    "nitropack": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
